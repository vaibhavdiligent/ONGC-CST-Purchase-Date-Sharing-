<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD for SAP CPI message mapping - target structure of the OData V2 deep insert
  Service : /CCBJI/JCTINVR_SRV  (S/4HANA Gateway, OData V2)
  Call    : POST InvoiceRegistrationsSet  (Operation = Create, Sub-Levels = 1)
  Payload : ONE header (InvoiceRegistrations) wrapping MULTIPLE line items
            (InvoiceRegistration) - one item per NTA record.

  Notes for the mapping:
  - REQUEST_ID: leave unmapped/empty (response echoes summary "U:n S:m" in it).
  - INVOICE_CD is mandatory per item; all other item fields are optional.
  - Dates are strings; accepted formats: YYYYMMDD, YYYY-MM-DD, DD.MM.YYYY;
    empty or 00000000 = not maintained.
  - Do NOT add MANDT or audit fields (ZERNAM/ZERSDA/ZERZZT/ZAENAM/ZUPDAT/
    ZUPTIM/ZUPDIND) - the backend fills them.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- Root = entity set (as generated by the CPI OData V2 query modeler) -->
  <xs:element name="InvoiceRegistrationsSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="InvoiceRegistrations" type="InvoiceRegistrations_Type"
                    minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Header entity (technical parent, one per POST) -->
  <xs:complexType name="InvoiceRegistrations_Type">
    <xs:sequence>
      <xs:element name="REQUEST_ID" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="32"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <!-- Navigation property: the repeating NTA records -->
      <xs:element name="InvoiceRegistration" type="InvoiceRegistration_Type"
                  minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Item entity: one per NTA record, same format as /CCBJI/T_JCTINVR -->
  <xs:complexType name="InvoiceRegistration_Type">
    <xs:sequence>

      <!-- Invoice registration number (NTA registered number) - KEY, mandatory -->
      <xs:element name="INVOICE_CD" minOccurs="1" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Business processing classification -->
      <xs:element name="PROCESS_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Correction classification -->
      <xs:element name="CORRECTION_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Personnel classification -->
      <xs:element name="PERSONAL_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Domestic / foreign classification -->
      <xs:element name="DOMESTIC_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Latest history flag -->
      <xs:element name="LATEST_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Registration date -->
      <xs:element name="CREATE_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>
      <!-- Update date -->
      <xs:element name="UPDATE_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>
      <!-- Revocation date -->
      <xs:element name="REVOCATION_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>
      <!-- Expiration date -->
      <xs:element name="EXPIRATION_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>

    </xs:sequence>
  </xs:complexType>

  <!-- Date as string: YYYYMMDD, YYYY-MM-DD or DD.MM.YYYY; empty/00000000 = initial -->
  <xs:simpleType name="Date_Type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="10"/>
      <xs:pattern value="|0{8}|[0-9]{8}|[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{2}\.[0-9]{2}\.[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
