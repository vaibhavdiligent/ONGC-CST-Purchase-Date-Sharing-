<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD v1.1 for SAP CPI message mapping - target structure of the OData V2
  deep insert (Operation = Create, Sub-Levels = 1).
  Service : /CCBJI/JCTINVR_SRV  (S/4HANA Gateway, OData V2)
  POST    : InvoiceRegistrationsSet

  v1.1 CHANGE: the CPI OData V2 adapter expects the navigation property as a
  WRAPPER node that contains one entity-type node PER RECORD. Because the
  navigation property and the item entity type are both named
  "InvoiceRegistration", the element appears TWICE (wrapper + per record):

    <InvoiceRegistrationsSet>            root = entity set
      <InvoiceRegistrations>             header entity (1 per POST)
        <REQUEST_ID/>                    leave empty / unmapped
        <InvoiceRegistration>            navigation property (wrapper, 1x)
          <InvoiceRegistration>          item entity - record 1
            <INVOICE_CD>...</INVOICE_CD>
            ...
          </InvoiceRegistration>
          <InvoiceRegistration>          item entity - record 2
            ...
          </InvoiceRegistration>
        </InvoiceRegistration>
      </InvoiceRegistrations>
    </InvoiceRegistrationsSet>

  IMPORTANT for the mapping:
  - Keep the ITEM FIELDS IN THIS EXACT ORDER (the adapter validates the
    payload against the $metadata property order): INVOICE_CD, PROCESS_KBN,
    CORRECTION_KBN, PERSONAL_KBN, DOMESTIC_KBN, LATEST_KBN, CREATE_DATE,
    UPDATE_DATE, REVOCATION_DATE, EXPIRATION_DATE.
  - No XML namespaces in the payload nodes.
  - Dates as strings: YYYYMMDD, YYYY-MM-DD or DD.MM.YYYY; empty/00000000 = initial.
  - Do NOT add MANDT or audit fields (ZERNAM/ZERSDA/ZERZZT/ZAENAM/ZUPDAT/
    ZUPTIM/ZUPDIND) - the backend fills them.
  - Authoritative structure = the one the adapter's query modeler generates
    ("Select" on InvoiceRegistrationsSet with Sub-Levels = 1 against the LIVE
    $metadata). This XSD mirrors it; if they ever differ, the modeler wins.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- Root = entity set -->
  <xs:element name="InvoiceRegistrationsSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="InvoiceRegistrations" type="InvoiceRegistrations_Type"
                    minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Header entity (technical parent, one per POST) -->
  <xs:complexType name="InvoiceRegistrations_Type">
    <xs:sequence>
      <xs:element name="REQUEST_ID" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="32"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <!-- Navigation property WRAPPER (exactly one) -->
      <xs:element name="InvoiceRegistration" type="NavInvoiceRegistration_Type"
                  minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Navigation property wrapper: contains one item entity node per record -->
  <xs:complexType name="NavInvoiceRegistration_Type">
    <xs:sequence>
      <xs:element name="InvoiceRegistration" type="InvoiceRegistration_Type"
                  minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Item entity: one per NTA record, same format as /CCBJI/T_JCTINVR.
       Field order matters - keep as defined here. -->
  <xs:complexType name="InvoiceRegistration_Type">
    <xs:sequence>

      <!-- Invoice registration number (NTA registered number) - KEY, mandatory -->
      <xs:element name="INVOICE_CD" minOccurs="1" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Business processing classification -->
      <xs:element name="PROCESS_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Correction classification -->
      <xs:element name="CORRECTION_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Personnel classification -->
      <xs:element name="PERSONAL_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Domestic / foreign classification -->
      <xs:element name="DOMESTIC_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Latest history flag -->
      <xs:element name="LATEST_KBN" minOccurs="0" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <!-- Registration date -->
      <xs:element name="CREATE_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>
      <!-- Update date -->
      <xs:element name="UPDATE_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>
      <!-- Revocation date -->
      <xs:element name="REVOCATION_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>
      <!-- Expiration date -->
      <xs:element name="EXPIRATION_DATE" type="Date_Type" minOccurs="0" maxOccurs="1"/>

    </xs:sequence>
  </xs:complexType>

  <!-- Date as string: YYYYMMDD, YYYY-MM-DD or DD.MM.YYYY; empty/00000000 = initial -->
  <xs:simpleType name="Date_Type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="10"/>
      <xs:pattern value="|0{8}|[0-9]{8}|[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{2}\.[0-9]{2}\.[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
