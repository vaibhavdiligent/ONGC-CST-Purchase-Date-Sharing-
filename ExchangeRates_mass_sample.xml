  </ExchangeRate>
  <ExchangeRate>
    <RATE_TYPE>M</RATE_TYPE>
    <FROM_CURR>AED</FROM_CURR>
    <TO_CURRNCY>INR</TO_CURRNCY>
    <VALID_FROM>01.04.2025</VALID_FROM>
    <EXCH_RATE>22.66000</EXCH_RATE>
    <FROM_FACTOR>1</FROM_FACTOR>
