FORM get_vendor .
  IF lt_bseg IS NOT INITIAL.
    SELECT lifnr
           land1
           name1
           stcd3
      FROM lfa1
      INTO TABLE lt_lfa1
      FOR ALL ENTRIES IN lt_bseg
      WHERE lifnr = lt_bseg-lifnr
        AND lifnr IN vendor.

  ENDIF.

  IF lt_lfa1 IS NOT INITIAL.
    SELECT spras
           land1
           landx
      FROM t005t
      INTO TABLE lt_t005t
      FOR ALL ENTRIES IN lt_lfa1
      WHERE land1 = lt_lfa1-land1
       AND spras = 'E'.
  ENDIF.
