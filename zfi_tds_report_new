FORM get_bkpf .

  REFRESH:lt_bkpf.
  IF p_bukrs IS INITIAL.

    SELECT bukrs
        belnr
        gjahr
        bldat
        budat
        xblnr
        stblg
        bktxt
   FROM bkpf INTO TABLE lt_bkpf
   WHERE budat IN postdate.

  ELSE.

    SELECT bukrs
           belnr
           gjahr
           bldat
           budat
           xblnr
           stblg
           bktxt
       FROM bkpf INTO TABLE lt_bkpf
      WHERE budat IN postdate
        AND bukrs = p_bukrs.
  ENDIF.
ENDFORM.                    " GET_BKPF
