    " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
*    SELECT bukrs
*           belnr
*           gjahr
*           buzei
*           rebzg
*      FROM bseg INTO CORRESPONDING FIELDS OF TABLE it_bseg_r
*      FOR ALL ENTRIES IN lt_with_item
*      WHERE bukrs = lt_with_item-bukrs
*        AND belnr = lt_with_item-belnr
*        AND gjahr = lt_with_item-gjahr
*        AND rebzg NE ''.
    SELECT  companycode AS bukrs , accountingdocument AS belnr ,
   fiscalyear AS gjahr , accountingdocumentitem AS buzei ,
   invoicereference AS rebzg FROM i_operationalacctgdocitem FOR ALL
   ENTRIES IN @lt_with_item WHERE companycode = @lt_with_item-bukrs AND
   accountingdocument = @lt_with_item-belnr AND fiscalyear =
   @lt_with_item-gjahr AND invoicereference NE '' INTO CORRESPONDING
   FIELDS  OF  TABLE  @it_bseg_r .
    " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC

