            inv_valf = ls_curr5-kursf * ls_skfbt.
            CLEAR ls_curr5.
          ENDLOOP.

        ENDIF.

        ls_final9-inv = inv_valf.
*     clear ls_final9.

*        IF INV_AMT = LS_FINAL9-TAX.
*
*          IF LS_SKFBT IS NOT INITIAL.
*            IF INV_AMT = LS_SKFBT.
*              LS_FINAL9-INV = INV_AMT.
*
*            ELSEIF LS_SKFBT > INV_AMT.
*              LS_FINAL9-INV = LS_SKFBT.
*
*            ELSE.
*              LS_FINAL9-INV = INV_AMT.
*            ENDIF.
