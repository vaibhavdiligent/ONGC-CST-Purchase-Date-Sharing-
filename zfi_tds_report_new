FORM get_docs .
  CLEAR lt_bseg.

  IF lt_with_item IS NOT INITIAL.
    " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
*    SELECT  bukrs
*            belnr
*            gjahr
*            buzei
*            augdt
*            bschl
*            ktosl
*            bupla
*            secco
*            valut
*            ebeln
*            lifnr
*       FROM bseg INTO CORRESPONDING FIELDS OF TABLE lt_bseg
*     FOR ALL ENTRIES IN lt_with_item
*     WHERE bukrs = lt_with_item-bukrs
*       AND belnr = lt_with_item-belnr
*       AND gjahr = lt_with_item-gjahr.
    SELECT  companycode AS bukrs , accountingdocument AS belnr ,
   fiscalyear AS gjahr , accountingdocumentitem AS buzei , clearingdate AS
   augdt , postingkey AS bschl , transactiontypedetermination AS ktosl ,
   businessplace AS bupla , taxsection AS secco , valuedate AS valut ,
   purchasingdocument AS ebeln , supplier AS lifnr FROM
   i_operationalacctgdocitem FOR ALL ENTRIES IN @lt_with_item WHERE
   companycode = @lt_with_item-bukrs AND accountingdocument =
   @lt_with_item-belnr AND fiscalyear = @lt_with_item-gjahr INTO
   CORRESPONDING  FIELDS  OF  TABLE  @lt_bseg .
