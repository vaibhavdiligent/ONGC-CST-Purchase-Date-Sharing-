*&---------------------------------------------------------------------*
*&      Form  GET_ZFI_WITH_ITEMS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_ongc_docs.

  DATA lv_taxbase TYPE string.
  DATA lv_invamt TYPE string.
  DATA lv_taxamt TYPE string.

  IF p_bukrs IS INITIAL.
    SELECT bukrs,
        belnr,
        gjahr,
        zbukrs,
        zbelnr,
        zgjahr,
        bldat,
        budat,
        xblnr,
        stblg,
        bktxt
   FROM zfibkpf INTO TABLE @DATA(lt_zbkpf)
   WHERE budat IN @postdate.
  ELSE.
    SELECT bukrs
           belnr
           gjahr
           zbukrs
           zbelnr
           zgjahr
           bldat
           budat
           xblnr
           stblg
           bktxt
  FROM zfibkpf INTO TABLE lt_zbkpf
      WHERE budat IN postdate
        AND bukrs = p_bukrs.
  ENDIF.


  IF lt_zbkpf IS NOT INITIAL.
    SELECT belnr,
           bukrs,
           gjahr,
           witht,
           wt_qsshh,
           wt_acco,
           wt_qbshh
      FROM zfi_with_item INTO TABLE @DATA(lt_zwith_item)
      FOR ALL ENTRIES IN @lt_zbkpf
      WHERE bukrs = @lt_zbkpf-bukrs
         AND belnr = @lt_zbkpf-belnr
         AND gjahr = @lt_zbkpf-gjahr
         AND wt_withcd IN ('CG','SG','IG')
         AND wt_qsshh NE 0.


    REFRESH it_bsas[].
    SELECT bukrs
           hkont
           augdt
           augbl
           gjahr
           belnr
           buzei
           budat
      FROM bsas INTO TABLE it_bsas
      FOR ALL ENTRIES IN lt_zbkpf
      WHERE bukrs = lt_zbkpf-bukrs
        AND hkont IN ( '0000190204' , '0000190205' , '0000190206' , '0000190207' )
        AND belnr = lt_zbkpf-zbelnr
        AND gjahr = lt_zbkpf-zgjahr.

  ENDIF.


  IF lt_zwith_item IS NOT INITIAL.
    SELECT
      witht,
      wt_withcd,
      qsatz FROM t059z
      INTO TABLE @DATA(lt_zt059z)
      WHERE witht IN ('CZ','SZ','IZ')
        AND wt_withcd IN ('Z1','Z2','Z3').
  ENDIF.


  IF lt_zwith_item IS NOT INITIAL.
    SELECT bukrs,
           belnr,
           gjahr,
           buzei,
           augdt,
           bschl,
           koart,
           ktosl,
           bupla,
           secco,
           valut,
           ebeln,
           lifnr
      FROM zfi_bseg INTO TABLE @DATA(lt_zbseg)
     FOR ALL ENTRIES IN @lt_zwith_item
     WHERE bukrs = @lt_zwith_item-bukrs
       AND belnr = @lt_zwith_item-belnr
       AND gjahr = @lt_zwith_item-gjahr.


    " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
*    SELECT bukrs,
*          belnr,
*          gjahr,
*          buzei,
*          augdt,
*          bschl,
*          koart,
*          ktosl,
*          bupla,
*          secco,
*          valut,
*          ebeln,
*          lifnr
*     FROM bseg INTO TABLE @DATA(lt_zbseg_k)
*    FOR ALL ENTRIES IN @lt_zbkpf
*    WHERE bukrs = @lt_zbkpf-zbukrs
*      AND belnr = @lt_zbkpf-zbelnr
*      AND gjahr = @lt_zbkpf-zgjahr
*      AND koart = 'K'.
    SELECT  companycode AS bukrs , accountingdocument AS belnr ,
   fiscalyear AS gjahr , accountingdocumentitem AS buzei , clearingdate AS
   augdt , postingkey AS bschl , financialaccounttype AS koart ,
   transactiontypedetermination AS ktosl , businessplace AS bupla ,
   taxsection AS secco , valuedate AS valut , purchasingdocument AS ebeln ,
    supplier AS lifnr FROM i_operationalacctgdocitem FOR ALL ENTRIES IN
   @lt_zbkpf WHERE companycode = @lt_zbkpf-zbukrs AND accountingdocument =
   @lt_zbkpf-zbelnr AND fiscalyear = @lt_zbkpf-zgjahr AND
   financialaccounttype = 'K' INTO TABLE  @DATA(lt_zbseg_k).
    " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC

  ENDIF.

  SORT lt_zbseg BY belnr gjahr lifnr DESCENDING.

  DELETE ADJACENT DUPLICATES FROM lt_zbseg COMPARING belnr gjahr .


  IF lt_zbseg_k IS NOT INITIAL OR vendor IS NOT INITIAL.
    SELECT lifnr,
          land1,
          name1,
          stcd3
     FROM lfa1 INTO TABLE @DATA(lt_zlfa1)
     FOR ALL ENTRIES IN @lt_zbseg_k
     WHERE lifnr = @lt_zbseg_k-lifnr
       AND lifnr IN @vendor.

  ENDIF.

  IF lt_zlfa1 IS NOT INITIAL.
    SELECT spras,
           land1,
           landx
      FROM t005t INTO TABLE @DATA(lt_zt005t)
      FOR ALL ENTRIES IN @lt_zlfa1
      WHERE land1 = @lt_zlfa1-land1
        AND spras = 'E'.

  ENDIF.


  SORT lt_zbkpf BY belnr gjahr bukrs.
  SORT lt_zwith_item BY belnr bukrs gjahr.
  SORT lt_zlfa1 BY lifnr.
  SORT lt_zbseg BY belnr gjahr bukrs.
  SORT lt_zt059z BY witht.
  DELETE ADJACENT DUPLICATES FROM lt_zwith_item COMPARING belnr bukrs gjahr witht.


  LOOP AT lt_zwith_item INTO ls_with_item WHERE witht = 'IG' OR witht = 'CG' OR witht = 'SG'.

    ls_zfinal-witht    = ls_with_item-witht.
    ls_zfinal-wt_qsshh = ls_with_item-wt_qsshh.
    ls_zfinal-inv      = ls_with_item-wt_qsshh.
    ls_zfinal-tax      = ls_with_item-wt_qsshh.
    READ TABLE lt_zbkpf INTO DATA(ls_zbkpf) WITH KEY belnr = ls_with_item-belnr
                                              bukrs = ls_with_item-bukrs
                                              gjahr = ls_with_item-gjahr BINARY SEARCH.

    READ TABLE lt_zbseg_k INTO DATA(ls_zbseg_k) WITH KEY bukrs = ls_zbkpf-zbukrs
                                                         belnr = ls_zbkpf-zbelnr
                                                         gjahr = ls_zbkpf-zgjahr
                                                         koart = 'K' .


    READ TABLE lt_zlfa1 INTO ls_lfa1 WITH KEY lifnr  = ls_zbseg_k-lifnr .
    IF sy-subrc = 0.
      ls_zfinal-name1 = ls_lfa1-name1.
      ls_zfinal-stcd3 = ls_lfa1-stcd3.

      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          input  = ls_lfa1-lifnr
        IMPORTING
          output = ls_lfa1-lifnr.

      ls_zfinal-lifnr = ls_lfa1-lifnr.
      ls_zfinal-land1 = ls_lfa1-land1.
    ENDIF.

    READ TABLE lt_zt005t INTO ls_t005t WITH KEY land1 = ls_lfa1-land1.
    IF sy-subrc = 0.
      ls_zfinal-landx = ls_t005t-landx.
    ENDIF.


    IF sy-subrc = 0 .
      ls_zfinal-bktxt = ls_zbkpf-bktxt.
      ls_zfinal-bldat = ls_zbkpf-bldat.
      ls_zfinal-xblnr = ls_zbkpf-xblnr.
      ls_zfinal-gjahr = ls_zbkpf-gjahr.
      ls_zfinal-bukrs = ls_zbkpf-bukrs.
      ls_zfinal-belnr = ls_zbkpf-zbelnr.
      ls_zfinal-budat = ls_zbkpf-budat.
    ENDIF.

    READ TABLE lt_zbseg INTO DATA(ls_zbseg) WITH KEY belnr = ls_with_item-belnr
                                                       gjahr = ls_with_item-gjahr
                                                       bukrs = ls_with_item-bukrs BINARY SEARCH.

    ls_zfinal-bschl = ls_zbseg-bschl.
    ls_zfinal-gstin = '07AAACO1230F1DB'.

    IF ls_lfa1-lifnr IS NOT INITIAL.
      APPEND ls_zfinal TO lt_zfinal.
    ENDIF.

    CLEAR:ls_zbkpf,ls_with_item,ls_zfinal,ls_lfa1,ls_with_item,ls_zbseg.
  ENDLOOP.


  SORT lt_zwith_item BY belnr bukrs gjahr.
  SORT lt_zfinal BY belnr bukrs gjahr.

  DATA lt_zwith_item2 TYPE STANDARD TABLE OF ty_with_item.

  MOVE-CORRESPONDING lt_zwith_item[] TO lt_zwith_item2[] .
  DELETE lt_zwith_item WHERE witht = 'CG' OR witht = 'SG'.

  LOOP AT lt_zwith_item INTO ls_with_item WHERE witht = 'IG'.
    READ TABLE lt_zbkpf INTO ls_zbkpf WITH KEY belnr = ls_with_item-belnr
                                                      bukrs = ls_with_item-bukrs
                                                      gjahr = ls_with_item-gjahr.

    READ TABLE lt_zfinal INTO ls_zfinal WITH KEY belnr = ls_zbkpf-zbelnr
                                                 gjahr = ls_zbkpf-zgjahr
                                                 bukrs = ls_zbkpf-zbukrs.

    ls_zfinal-lv_iz =  ls_zfinal-lv_iz + ls_with_item-wt_qbshh * -1.

    READ TABLE lt_zt059z INTO DATA(ls_zt059z) WITH KEY wt_withcd = 'Z3'.
    ls_zfinal-qsatz = ls_zt059z-qsatz.

    AT END OF belnr.
      MODIFY TABLE lt_zfinal FROM ls_zfinal TRANSPORTING lv_iz qsatz .
      CLEAR : ls_zfinal,ls_with_item.
    ENDAT.
  ENDLOOP.


  MOVE-CORRESPONDING lt_zwith_item2[] TO lt_zwith_item[].
  DELETE lt_zwith_item WHERE witht = 'IG' OR witht = 'SG'.

  LOOP AT lt_zwith_item INTO ls_with_item WHERE witht = 'CG'.
    READ TABLE lt_zbkpf INTO ls_zbkpf WITH KEY belnr = ls_with_item-belnr
                                                     bukrs = ls_with_item-bukrs
                                                     gjahr = ls_with_item-gjahr.

    READ TABLE lt_zfinal INTO ls_zfinal WITH KEY belnr = ls_zbkpf-zbelnr
                                                 gjahr = ls_zbkpf-zgjahr
                                                 bukrs = ls_zbkpf-zbukrs.

    ls_zfinal-lv_cz =  ls_zfinal-lv_cz + ls_with_item-wt_qbshh * -1.

    READ TABLE lt_zt059z INTO ls_zt059z WITH KEY wt_withcd = 'Z1'.
    ls_zfinal-qsatz1 = ls_zt059z-qsatz.

    AT END OF belnr.
      MODIFY TABLE lt_zfinal FROM ls_zfinal TRANSPORTING lv_cz qsatz1 .
      CLEAR : ls_zfinal,ls_with_item.
    ENDAT.
  ENDLOOP.


  MOVE-CORRESPONDING lt_zwith_item2[] TO lt_zwith_item[].
  DELETE lt_zwith_item WHERE witht = 'IG' OR witht = 'CG'.

  LOOP AT lt_zwith_item INTO ls_with_item WHERE witht = 'SG'.
    READ TABLE lt_zbkpf INTO ls_zbkpf WITH KEY belnr = ls_with_item-belnr
                                                     bukrs = ls_with_item-bukrs
                                                     gjahr = ls_with_item-gjahr.

    READ TABLE lt_zfinal INTO ls_zfinal WITH KEY belnr = ls_zbkpf-zbelnr
                                                 gjahr = ls_zbkpf-zgjahr
                                                 bukrs = ls_zbkpf-zbukrs.

    ls_zfinal-lv_sz = ls_zfinal-lv_sz + ls_with_item-wt_qbshh * -1.

    READ TABLE lt_zt059z INTO ls_zt059z WITH KEY wt_withcd = 'Z2'.
    ls_zfinal-qsatz2 = ls_zt059z-qsatz.

    AT END OF belnr.
      MODIFY TABLE lt_zfinal FROM ls_zfinal TRANSPORTING lv_sz qsatz2 .
      CLEAR : ls_zfinal,ls_with_item.
    ENDAT.
  ENDLOOP.

  DELETE lt_zfinal WHERE lv_iz = '0.00' AND lv_cz = '0.00' AND lv_sz = '0.00'.
  SORT lt_zfinal BY belnr lifnr inv lv_iz lv_cz lv_sz DESCENDING.
  DELETE ADJACENT DUPLICATES FROM lt_zfinal COMPARING belnr lifnr inv tax wt_qsshh.

  IF lt_zfinal IS NOT INITIAL.
    LOOP AT lt_zfinal INTO ls_zfinal.

      lv_taxbase = ls_zfinal-wt_qsshh.
      IF lv_taxbase CA '-'.
        ls_zfinal-wt_qsshh = ls_zfinal-wt_qsshh * -1.
      ENDIF.

      lv_invamt = ls_zfinal-inv.
      IF lv_invamt CA '-'.
        ls_zfinal-inv = ls_zfinal-inv * -1.
      ENDIF.

      lv_taxamt = ls_zfinal-tax.
      IF lv_taxamt CA '-'.
        ls_zfinal-tax = ls_zfinal-tax * -1.
      ENDIF.

      LOOP AT it_bsas INTO DATA(wa_bsas) WHERE bukrs = ls_zfinal-bukrs AND belnr = ls_zfinal-belnr AND budat = ls_zfinal-budat.
        IF wa_bsas IS NOT INITIAL.
          IF ls_zfinal-lv_cz IS NOT INITIAL AND wa_bsas-hkont = '0000190204'.
            ls_zfinal-cgstcl  = wa_bsas-augbl.
            ls_zfinal-cgstcld = wa_bsas-augdt.
          ELSEIF ls_zfinal-lv_sz IS NOT INITIAL AND ( wa_bsas-hkont = '0000190205' OR wa_bsas-hkont = '0000190207' ).
            ls_zfinal-sgstcl  = wa_bsas-augbl.
            ls_zfinal-sgstcld = wa_bsas-augdt.
          ELSEIF ls_zfinal-lv_iz IS NOT INITIAL AND wa_bsas-hkont = '0000190206'.
            ls_zfinal-igstcl  = wa_bsas-augbl.
            ls_zfinal-igstcld = wa_bsas-augdt.
          ENDIF.
        ENDIF.
        CLEAR : wa_bsas.
      ENDLOOP.
*        MODIFY lt_final9 FROM ls_final9 TRANSPORTING cgstcl cgstcld sgstcl sgstcld igstcl igstcld.
************added by aparna
      IF ls_zfinal-lv_cz LT '0.00' OR ls_zfinal-lv_iz  LT '0.00'  OR ls_zfinal-lv_sz   LT '0.00'.
        ls_zfinal-inv = ls_zfinal-inv * ( -1 ).
        ls_zfinal-tax = ls_zfinal-tax * ( -1 ) .
        ls_zfinal-wt_qsshh = ls_zfinal-wt_qsshh * ( -1  ).
      ENDIF.
**************      ended by aparna
      APPEND ls_zfinal TO lt_final9.
      CLEAR: ls_zfinal,lv_taxbase,lv_invamt,lv_taxamt.

    ENDLOOP.
  ENDIF.


ENDFORM.
