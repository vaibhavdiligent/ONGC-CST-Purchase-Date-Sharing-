FORM get_bsas .
*********changes for clearing doc
  SELECT bukrs
         hkont
         augdt
         augbl
         gjahr
         belnr
         buzei
         budat
    FROM bsas INTO TABLE it_bsas
    FOR ALL ENTRIES IN lt_bkpf
    WHERE bukrs = lt_bkpf-bukrs
      AND hkont IN ( '0000190204' , '0000190205' , '0000190206' , '0000190207' )
      AND belnr = lt_bkpf-belnr
      AND gjahr = lt_bkpf-gjahr.
ENDFORM.
