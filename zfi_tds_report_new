*
*          LS_FINAL9-INV = INV_AMT.
*
*        ENDIF.


*             ls_final9-inv = INV_AMT.

************end of code *****************





      ENDIF.
    ENDIF.

    ls_final9-gstin = '07AAACO1230F1DB'.      ""added on 2/6/22 by hrishi n
    MODIFY lt_final9 FROM ls_final9.
    CLEAR: ls_final9, inv_val1, inv_val1_n, inv_val2, inv_val3, inv_val4 , inv_amt , inv_valf,  ls_curr1,ls_curr2 , ls_curr3, ls_curr4,ls_curr5 , lt_curr1[], lt_curr[]..
