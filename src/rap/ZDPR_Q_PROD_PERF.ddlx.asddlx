@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName:       'Production Performance',
  typeNamePlural: 'Production Performance',
  title:          { type: #STANDARD, value: 'ProductGroupText' },
  description:    { type: #STANDARD, value: 'ScopeText' }
}

@UI.chart: [{
  qualifier:  'PerfByGroup',
  title:      'Actual vs BE Target (BOEPD)',
  chartType:  #COLUMN,
  dimensions: ['ProductGroupText', 'ScopeText'],
  measures:   ['ActualBoepdPerDay', 'TargetBoepdPerDay'],
  measureAttributes: [
    { measure: 'ActualBoepdPerDay', role: #AXIS_1, asDataPoint: true },
    { measure: 'TargetBoepdPerDay', role: #AXIS_1, asDataPoint: true }
  ],
  dimensionAttributes: [
    { dimension: 'ProductGroupText', role: #CATEGORY },
    { dimension: 'ScopeText',        role: #SERIES   }
  ]
}]

@UI.presentationVariant: [{
  qualifier:      'Default',
  visualizations: [
    { type: #AS_CHART, qualifier: 'PerfByGroup' },
    { type: #AS_LINEITEM }
  ],
  sortOrder:      [{ by: 'ScopeType', direction: #DESC }]
}]

annotate view ZDPR_Q_PROD_PERF with
{
  @UI.lineItem: [{ position: 10, importance: #HIGH, label: 'Scope' }]
  ScopeText;

  @UI.lineItem: [{ position: 20, importance: #HIGH, label: 'Product' }]
  ProductGroupText;

  @UI.lineItem: [{ position: 30, importance: #HIGH, label: 'Actual (BOPD / MMSCMD)' }]
  ActualPerDay;

  @UI.lineItem: [{ position: 40, importance: #HIGH, label: 'BE Target (BOPD / MMSCMD)' }]
  TargetPerDay;

  @UI.lineItem: [{ position: 50, importance: #HIGH, label: 'Actual Total (BOEPD)' }]
  ActualBoepdPerDay;

  @UI.lineItem: [{ position: 60, importance: #HIGH, label: 'BE Target Total (BOEPD)' }]
  TargetBoepdPerDay;

  @UI.lineItem: [{ position: 70, importance: #HIGH, label: '% Achv w.r.t. BE Target',
                   criticality: 'AchievementCriticality' }]
  @UI.dataPoint: {
    title: '% Achv w.r.t. BE Target',
    criticalityCalculation: {
      improvementDirection:    #TARGET,
      deviationRangeLowValue:  90,
      toleranceRangeLowValue:  100,
      toleranceRangeHighValue: 999,
      deviationRangeHighValue: 9999
    }
  }
  AchievementPct;
}
