          wa_final-doctyp = 'Regular Invoice'.

        ELSEIF wa_bkpf-blart = 'DG' OR wa_bkpf-blart = 'KG' OR wa_bkpf-blart = 'RC'.

          wa_final-doctyp = 'Credit Note'.
          wa_final-nvcnum = wa_bkpf-xblnr.
          wa_final-nvcdat = wa_bkpf-bldat.

        ELSEIF wa_bkpf-blart = 'RD'.
          wa_final-doctyp = 'Debit Note'.
          wa_final-nvcnum = wa_bkpf-xblnr.
          wa_final-nvcdat = wa_bkpf-bldat.

        ELSEIF wa_bkpf-blart = 'RV'.
          SELECT SINGLE fkart FROM vbrk INTO @DATA(v_fkart) WHERE vbeln = @wa_bkpf-awkey.
          IF sy-subrc = 0.
            IF v_fkart = 'ZSCR' OR v_fkart = 'ZSET' OR v_fkart = 'ZSEM' .
              wa_final-doctyp = 'Regular Invoice'.

            ELSEIF v_fkart = 'ZCR1'.
              wa_final-doctyp = 'Credit Note'.
              wa_final-resnot = 'Sales Return'.

            ELSEIF v_fkart = 'ZDR1'.
              wa_final-doctyp = 'Debit Note'.

            ELSEIF v_fkart = 'ZEXP'.
              wa_final-doctyp = 'Bill of Supply'.

            ENDIF.
          ENDIF.

          IF wa_bkpf-blart = 'KR'.
            wa_final-typgsr = 'Goods'.

          ELSEIF wa_bkpf-blart = 'RV'.
            SELECT SINGLE pstyv FROM vbrp INTO @DATA(v_pstyv) WHERE vbeln = @wa_bkpf-awkey.
            IF sy-subrc = 0.
              IF v_pstyv NE 'TAD'.
                wa_final-typgsr = 'Goods'.
              ELSE.
                wa_final-typgsr = 'Services'.
              ENDIF.
            ENDIF.

          ELSE.
            wa_final-typgsr = 'Services'.
          ENDIF.
        ENDIF.

        IF wa_bkpf-blart = 'KR' OR wa_bkpf-blart = 'KS'.

          READ TABLE it_bkpf2 INTO wa_bkpf2 WITH KEY awkey = wa_bkpf-awkey BINARY SEARCH.
          IF sy-subrc = 0.
            READ TABLE it_rbkp INTO wa_rbkp WITH KEY belnr = wa_bkpf2-belnr gjahr = wa_bkpf2-gjahr BINARY SEARCH.
            IF sy-subrc = 0.
              READ TABLE it_temp INTO wa_temp WITH KEY stblg = wa_rbkp-stblg BINARY SEARCH.
              IF sy-subrc = 0.
                READ TABLE it_bkpf_r INTO wa_bkpf_r WITH KEY awkey = wa_temp-awkey BINARY SEARCH.
                IF sy-subrc = 0.
                  wa_final-revdoc = wa_bkpf_r-belnr.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.

        ELSEIF wa_bkpf-blart = 'RV'.                                                     ""Added on 7/6/22 by hrishi n
