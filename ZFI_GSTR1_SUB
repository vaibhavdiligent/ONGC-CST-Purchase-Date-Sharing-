          IF sy-subrc = 0.
            IF canc_doc IS NOT INITIAL OR canc_doc = wa_bkpf-awkey.
              wa_final-revdoc = canc_doc.
            ENDIF.
            CLEAR canc_doc.
          ELSEIF sy-subrc <> 0.
            SELECT SINGLE vbeln,sfakn FROM vbrk INTO @DATA(canc_doc1) WHERE vbeln = @wa_bkpf-awkey.
            IF canc_doc1-sfakn IS NOT INITIAL.
              wa_final-revdoc = canc_doc1-sfakn.
            ENDIF.

          ENDIF.

        ELSE.
          wa_final-revdoc = wa_bkpf-stblg.
        ENDIF.

        IF wa_final-revdoc IS NOT INITIAL.

          IF wa_final-doctyp = 'Credit Note'.
            wa_final-invsta = 'Credit Note'.
          ELSEIF wa_final-doctyp = 'Debit Note'.
            wa_final-invsta = 'Debit Note'.
          ELSE.
