  ENDIF.
  IF it_final is not INITIAL.
  SELECT fwste, belnr FROM bset INTO TABLE  @DATA(t_tcs) FOR ALL ENTRIES IN @it_final      "SOC CHANGE FOR TCS FIELD ADD (04-04-2024) BY ROHIT
