*              wa_final-stypcd = 'B2CS'.
*            ELSE.
*              wa_final-stypcd = 'B2B'.
          ENDIF.

***********************          ended by aparna
        ENDIF.

      ENDIF.

      wa_final-report = ''.


      LOOP AT it_bsas INTO DATA(wa_bsas) WHERE bukrs = wa_bkpf-bukrs AND belnr = wa_bkpf-belnr AND gjahr = wa_bkpf-gjahr.
        IF sy-subrc EQ 0.
          IF wa_final-cgstvl IS NOT INITIAL AND wa_bsas-hkont = '0000192404'.
