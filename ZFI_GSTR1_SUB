          IF wa_final-igstvl IS NOT INITIAL AND wa_bsas-hkont = '0000192402'.
            wa_final-igstcl  = wa_bsas-augbl.
            wa_final-igstcld = wa_bsas-augdt.
          ENDIF.
        ENDIF.
        CLEAR wa_bsas.
      ENDLOOP.

