          ENDIF.

        ENDIF.
endif.


      READ TABLE it_bseg_k INTO DATA(wa_bseg2) WITH KEY belnr = wa_bseg-belnr BINARY SEARCH.
      IF sy-subrc = 0.
        wa_final-iccode = wa_bseg2-kunnr.

        READ TABLE it_kna1 INTO DATA(wa_kna1) WITH KEY kunnr = wa_bseg2-kunnr BINARY SEARCH.
